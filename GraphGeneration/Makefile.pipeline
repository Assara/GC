# Run from the repository root: make -f GraphGeneration/Makefile.pipeline test
CXX ?= g++
PIPELINE_FLAGS ?= -std=c++23 -O1 -I. -IVectorSpace
.DEFAULT_GOAL := all

TRIANGLE_MAX_LOOP ?= 6
TRIANGLE_OUTPUT ?= output/triangle_seeds_L$(TRIANGLE_MAX_LOOP)
TRIANGLE_BINARY := build/triangle_seeds_unrestricted_L$(TRIANGLE_MAX_LOOP)
GRAPH_HEADERS := graph.hpp GraphStandardizer.hpp GraphIsomorphism.hpp CombinatorialUtils.hpp permutation.hpp types.hpp graph_hash.hpp LinearProbeSet.hpp
TRIANGLE_HEADERS := GraphGeneration/UnrestrictedTriangleSeedGenerator.hpp GraphGeneration/TriangleGraphEntry.hpp GraphGeneration/TriangleCompletionBudget.hpp GraphGeneration/TriangleSeedKeyStandardizer.hpp GraphGeneration/ValenceGraphStandardizer.hpp $(GRAPH_HEADERS)

.PHONY: all triangle-seeds unrestricted-triangle-seeds run-triangle-seeds test
all: triangle-seeds triangle-splits-valence
triangle-seeds unrestricted-triangle-seeds: $(TRIANGLE_BINARY)
run-triangle-seeds: triangle-seeds
	./$(TRIANGLE_BINARY) "$(TRIANGLE_OUTPUT)"

$(TRIANGLE_BINARY): tools/generate_unrestricted_triangle_seeds.cpp $(TRIANGLE_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) -DGC_TRIANGLE_MAX_LOOP=$(TRIANGLE_MAX_LOOP) $< -o $@

.PHONY: test-cut-vertex-splits
test-cut-vertex-splits: build/cut_vertex_split_rule_test
	./build/cut_vertex_split_rule_test

build/cut_vertex_split_rule_test: tools/cut_vertex_split_rule_test.cpp GraphGeneration/CutVertexSplitRule.hpp $(GRAPH_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) $< -o $@

TRIANGLE_SPLIT_LOOP ?= 6
TRIANGLE_SEED_DIR ?= $(TRIANGLE_OUTPUT)
TRIANGLE_SPLIT_OUTPUT ?= output/triangle_splits_L$(TRIANGLE_SPLIT_LOOP)
TRIANGLE_SPLIT_BINARY := build/triangle_splits_L$(TRIANGLE_SPLIT_LOOP)
TRIANGLE_PARALLEL_SPLIT_BINARY := build/triangle_splits_omp_L$(TRIANGLE_SPLIT_LOOP)

.PHONY: triangle-splits-omp
triangle-splits-omp: $(TRIANGLE_PARALLEL_SPLIT_BINARY)

.PHONY: triangle-splits run-triangle-splits
triangle-splits: $(TRIANGLE_SPLIT_BINARY)

run-triangle-splits: triangle-splits
	./$(TRIANGLE_SPLIT_BINARY) "$(TRIANGLE_SEED_DIR)" "$(TRIANGLE_SPLIT_OUTPUT)"

TRIANGLE_SPLIT_HEADERS := GraphGeneration/TriangleSplitCommon.hpp GraphGeneration/ValenceGraphStandardizer.hpp GraphGeneration/SplitReservation.hpp GraphGeneration/SplitStageEstimate.hpp GraphGeneration/SplitReductionRule.hpp LinearProbeSet.hpp graph_hash.hpp GraphGeneration/CutVertexSplitRule.hpp graph.hpp GraphStandardizer.hpp GraphIsomorphism.hpp CombinatorialUtils.hpp permutation.hpp types.hpp

$(TRIANGLE_PARALLEL_SPLIT_BINARY): tools/split_triangle_seeds.cpp $(TRIANGLE_SPLIT_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) -fopenmp -DGC_TRIANGLE_PARALLEL_SPLITS -DGC_TRIANGLE_SPLIT_LOOP=$(TRIANGLE_SPLIT_LOOP) $< -o $@

$(TRIANGLE_SPLIT_BINARY): tools/split_triangle_seeds.cpp $(TRIANGLE_SPLIT_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) -DGC_TRIANGLE_SPLIT_LOOP=$(TRIANGLE_SPLIT_LOOP) $< -o $@

TRIANGLE_COMPARISON_DIR ?= output/triangle_comparison_L$(TRIANGLE_MAX_LOOP)
TRIANGLE_SPLIT_BINARIES = $(addprefix build/triangle_splits_L,$(shell seq 3 $(TRIANGLE_MAX_LOOP)))

.PHONY: triangle-comparison run-triangle-comparison
triangle-comparison: $(TRIANGLE_BINARY) $(TRIANGLE_SPLIT_BINARIES)

run-triangle-comparison: triangle-comparison
	bash tools/compare_triangle_pipeline.sh $(TRIANGLE_MAX_LOOP) "$(TRIANGLE_COMPARISON_DIR)" "$(TRIANGLE_BINARY)"

build/triangle_splits_L%: tools/split_triangle_seeds.cpp $(TRIANGLE_SPLIT_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) -DGC_TRIANGLE_SPLIT_LOOP=$* $< -o $@

.PHONY: test-split-reduction
test-split-reduction: build/split_reduction_rule_test
	./build/split_reduction_rule_test

build/split_reduction_rule_test: tools/split_reduction_rule_test.cpp $(TRIANGLE_SPLIT_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) $< -o $@

.PHONY: test-split-reservation
test-split-reservation: build/split_reservation_test
	./build/split_reservation_test

build/split_reservation_test: tools/split_reservation_test.cpp GraphGeneration/SplitReservation.hpp LinearProbeSet.hpp
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) $< -o $@

# Disk-backed, one target valence group at a time; existing pipeline stays available.
.PHONY: triangle-splits-valence
triangle-splits-valence: build/triangle_splits_valence_L$(TRIANGLE_SPLIT_LOOP)

build/triangle_splits_valence_L%: tools/split_triangle_seeds_by_valence.cpp GraphGeneration/ValenceSplitPlan.hpp $(TRIANGLE_SPLIT_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) -fopenmp -DGC_TRIANGLE_PARALLEL_SPLITS -DGC_TRIANGLE_SPLIT_LOOP=$* $< -o $@

# Usage: build/valence_split_pipeline_test_L9 REFERENCE_DIRECTORY RESULT_DIRECTORY
build/valence_split_pipeline_test_L%: tools/valence_split_pipeline_test.cpp GraphGeneration/ValenceSplitPlan.hpp $(TRIANGLE_SPLIT_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) -UNDEBUG -DGC_TRIANGLE_SPLIT_LOOP=$* $< -o $@

.PHONY: test-linear-probe-set
test-linear-probe-set: build/linear_probe_set_test
	./build/linear_probe_set_test

build/linear_probe_set_test: tools/linear_probe_set_test.cpp $(GRAPH_HEADERS)
	@mkdir -p build
	$(CXX) $(PIPELINE_FLAGS) $< -o $@

test: test-cut-vertex-splits test-split-reduction test-split-reservation test-linear-probe-set
